generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model SiteSettings {
  id              String   @id @default("default")
  name            String
  legal           String
  mission         String
  bookingsEmail   String
  inquiriesEmail  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Artist {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  displayName String
  portrait    String
  portraitAlt String
  debut       String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  posts       NewsPost[]

  @@index([slug])
}

model NewsPost {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  publishedAt DateTime
  excerpt   String
  body      String
  artistId  String?
  artist    Artist?  @relation(fields: [artistId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publishedAt])
  @@index([artistId])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  venue       String?
  startsAt    DateTime
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startsAt])
  @@index([published])
}

model Job {
  id          String   @id @default(cuid())
  title       String
  description String
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
}

model Inquiry {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([email])
}

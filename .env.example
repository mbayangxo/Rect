# ── RECT (this app) ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_RECT_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (webhooks / redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo payments only outside production (or set true to allow)
ALLOW_DEMO_PAYMENTS=true

# ── JOKO (mobile money: tips, packs, merch, downloads) ───────
JOKO_API_URL=
JOKO_API_KEY=
JOKO_WEBHOOK_SECRET=

# ── Taali (DSP delivery — separate Supabase + deploy) ────────
# Base URL of the Taali app (with or without /api — both work)
TAALI_API_URL=https://your-taali.vercel.app
TAALI_API_KEY=shared-secret-with-taali
# Required for live submit (UUID from Taali organizations table)
TAALI_ORG_ID=
# Optional provider rail (default: demo)
TAALI_PROVIDER_ID=demo
TAALI_WEBHOOK_SECRET=
# Optional: absolute URL Taali calls back on status changes
TAALI_WEBHOOK_URL=https://your-rect.vercel.app/api/taali/webhook

# ── FEKK (tour tickets — optional) ──────────────────────────
FEKK_API_URL=
FEKK_API_KEY=
FEKK_WEBHOOK_SECRET=
FEKK_SUCCESS_URL=
FEKK_CANCEL_URL=
